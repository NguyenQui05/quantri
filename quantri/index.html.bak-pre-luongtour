function addTag(staffId, field){
  const inputId = field==='tags' ? 'newTagInput' : 'newSkillInput';
  const val = (document.getElementById(inputId)?.value||'').trim();
  if(!val) return;
  const s = DATA.staff.find(x=>x.id===staffId);
  if(!s) return;
  s[field] = s[field] || [];
  if(!s[field].includes(val)){ s[field].push(val); saveData('staff',DATA.staff); openModal('staff-detail', s); toast(`✓ Đã thêm: ${val}`,'green'); renderStaff(); }
}
function removeTag(staffId, field, val){
  const s = DATA.staff.find(x=>x.id===staffId);
  if(!s) return;
  s[field] = (s[field]||[]).filter(t=>t!==val);
  saveData('staff',DATA.staff);
  openModal('staff-detail', s); renderStaff();
  toast(`✓ Đã xoá: ${val}`,'ok');
}
