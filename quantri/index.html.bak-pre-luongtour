    .card > table th{font-size:.6rem;padding:7px 9px}
    .card > table td{padding:10px 9px}
    .card > table .with-av span:not(.avatar){font-size:.78rem}
    .card > table .with-av span span{font-size:.66rem}
    /* Card head + body fit dù table cuộn */
    .card .card-head{position:sticky;left:0}
    .ai-chat{height:64vh;max-height:520px}
    .modal-bg{padding:0;align-items:flex-end}
    .modal{max-width:100%;width:100%;max-height:94vh;border-radius:18px 18px 0 0;animation:modalSlideUp .32s cubic-bezier(.16,1,.3,1)}
    .modal-head{padding:16px 18px}
    .modal-head h2{font-size:1.04rem}
    .modal-body{padding:16px 18px 22px}
    .modal-foot{padding:12px 18px;padding-bottom:calc(env(safe-area-inset-bottom, 0px) + 12px);flex-direction:column-reverse}
    .modal-foot .btn{width:100%;justify-content:center}
    .cal-grid{grid-template-columns:55px repeat(7,minmax(90px,1fr));min-width:680px;font-size:.7rem}
    .cal-grid > div{padding:7px 6px;min-height:54px}
    .booking{font-size:.66rem;padding:5px 6px}
    .svc-grid{grid-template-columns:repeat(2,1fr);gap:10px}
    .svc .pic{height:90px;font-size:2rem}
    .svc .body{padding:12px}
    .svc h3{font-size:.86rem}
    .svc .price{font-size:1.05rem}
    .gallery{grid-template-columns:repeat(2,1fr);gap:10px}
    .photo-pair .imgs{height:110px}
    .photo-pair .imgs > div{font-size:1.9rem}
    .btn{padding:9px 14px;font-size:.8rem}
    .btn.sm{padding:6px 11px;font-size:.74rem}
    .alert{font-size:.8rem;padding:11px;gap:8px}
    .alert > div{min-width:0}
    .alert button.btn{align-self:stretch;margin-top:6px;margin-left:0!important}
    .ai-card::before{display:none}
    .ai-insight{font-size:.8rem;padding:10px}
    .pill{font-size:.66rem;padding:3px 8px}
    .tier{font-size:.6rem;padding:2px 7px}
    /* Bottom safe-area cho input bar */
    input,select,textarea{font-size:16px}  /* tránh iOS zoom khi focus */
  }

  /* ===== Mobile nhỏ (iPhone SE / Mini / Android nhỏ ≤480px) ===== */
  @media (max-width:480px){
    aside{width:86vw;max-width:300px}
    header.topbar h1{font-size:1rem}
    header.topbar h1 .sub{font-size:.62rem}
    .topbar .profile{display:none}
    .topbar .icon-btn{width:36px;height:36px;font-size:.95rem}
    .kpi-grid{grid-template-columns:repeat(2,1fr);gap:9px}
    .kpi{padding:12px;border-radius:13px}
    .kpi .val{font-size:1.35rem}
    .card{padding:14px;border-radius:13px}
    section.page{padding:12px 12px 90px}
    .svc-grid{grid-template-columns:1fr}
    .gallery{grid-template-columns:1fr}
    .photo-pair .imgs{height:160px}
    .cal-grid{grid-template-columns:48px repeat(7,minmax(80px,1fr));min-width:600px}
    .alert{flex-direction:column}
    .alert .ic{font-size:1.3rem}
    .modal-head{padding:14px 16px}
    .modal-body{padding:14px 16px 18px}
  }

  /* ===== Mobile XS (≤360px — Galaxy Fold đóng / iPhone cũ) ===== */
  @media (max-width:360px){
    .kpi-grid{grid-template-columns:1fr}
    .kpi .val{font-size:1.6rem}
    header.topbar h1 .sub{display:none}
  }

  /* ===== Modal slide-up animation ===== */
  @keyframes modalSlideUp{
    from{opacity:0;transform:translateY(60px)}
    to{opacity:1;transform:none}
  }

  /* ===== Mobile landscape (điện thoại nằm ngang) ===== */
  @media (max-height:480px) and (orientation:landscape){
    aside{padding-top:14px}
    header.topbar{padding:8px 16px}
    .modal{max-height:94vh}
    .ai-chat{height:80vh}
  }

  /* ===== Touch-friendly: tap target ≥ 44px theo Apple HIG ===== */
  @media (hover:none) and (pointer:coarse){
    .nav a{padding:11px 12px}
    .btn{min-height:40px}
    .btn.sm{min-height:34px}
    tr.clickable td{padding:14px 11px}
    .kpi{padding:16px}
  }

  /* ===== Print / khi xuất PDF ===== */
  @media print{
    aside, header.topbar, .menu-toggle, .modal-bg, .toast, .alert button{display:none!important}
    .app{grid-template-columns:1fr}
    section.page{display:block!important;padding:0;page-break-after:always}
  }

  /* ===== Dark mode (tự động theo OS — tuỳ chọn nhẹ, không phá brand) ===== */
  @media (prefers-color-scheme:dark){
    /* giữ light mode mặc định để không lệch brand HANA, chỉ tinh chỉnh contrast */
    body{color-scheme:light}
  }
</style>
