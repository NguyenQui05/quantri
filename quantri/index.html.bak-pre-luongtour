  const times=['09:00','10:00','11:00','14:00','15:00','16:00','17:00'];
  const bookings = {
    '09:00': [{day:0,who:'A. Hoa',what:'Cắt mí',cls:''},{day:2,who:'C. Linh',what:'Tư vấn',cls:'b2'},{day:4,who:'C. Mai',what:'Filler',cls:''}],
