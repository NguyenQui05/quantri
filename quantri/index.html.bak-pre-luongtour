function exportExcel(key){
  if(!window.XLSX){ toast('⏳ Đang tải thư viện Excel...'); setTimeout(()=>exportExcel(key),1500); return; }
  const cfg = EXPORT_CONFIG[key];
  if(!cfg){ toast('❌ Không có cấu hình export cho '+key,'red'); return; }
  const rows = DATA[key].map(cfg.map);
  const ws = XLSX.utils.json_to_sheet(rows);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, cfg.sheet);
  const d = new Date(); const ds = `${d.getDate()}-${d.getMonth()+1}-${d.getFullYear()}`;
  XLSX.writeFile(wb, `${cfg.file}-${ds}.xlsx`);
  toast(`✓ Đã tải ${cfg.file}-${ds}.xlsx (${rows.length} dòng)`,'green');
}
function exportToWord(title, html){
  const doc = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset="utf-8"><title>${title}</title></head><body style="font-family:Arial">${html}</body></html>`;
  const blob = new Blob(['﻿', doc], {type:'application/msword'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `${title}.doc`; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href), 100);
  toast(`✓ Đã tải ${title}.doc`,'green');
}
