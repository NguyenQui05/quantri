<style>
  :root{
    --red:#A8231C; --red-deep:#7E150F;
    --orange:#E0762C; --orange-deep:#C9551A;
    --gold:#E8C25A; --gold-deep:#C99A2E;
    --brown:#5A3620; --brown-deep:#3B2113;
    --cream:#FFF8EC; --cream-2:#FBEFD8;
    --bg:#FAF7F2; --card:#fff; --line:#F0E5D0;
    --ink:#2A1B0E; --muted:#8b7a65;
    --green:#27AE60; --blue:#2C7BE5; --purple:#9B59B6;
    --grad:linear-gradient(135deg,#E8C25A 0%,#E0762C 50%,#A8231C 100%);
    --shadow:0 12px 40px -18px rgba(90,54,32,.35);
    --shadow-sm:0 4px 14px -6px rgba(90,54,32,.25);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  /* === FONT TỐI ƯU CHO NGƯỜI LỚN TUỔI ===
     Plus Jakarta Sans — sans rộng rãi, dễ đọc, premium
     Base 15.5px (thay 14), weight 500 default (thay 400)
     line-height 1.6 cho thoáng, letter-spacing 0.01em chống dính chữ */
  body{
    font-family:'Plus Jakarta Sans','Be Vietnam Pro',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
    background:var(--bg);color:var(--ink);
    font-size:15.5px;font-weight:500;line-height:1.6;letter-spacing:.005em;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
    text-rendering:optimizeLegibility;
  }
  h1,h2,h3,h4,.serif{font-family:'Playfair Display',Georgia,serif;font-weight:700;letter-spacing:-.01em;line-height:1.25}
  h1{font-size:1.65rem}
  h2{font-size:1.32rem}
  h3{font-size:1.08rem}
  a{color:inherit;text-decoration:none}
  button{font:inherit;cursor:pointer;border:0;background:none;color:inherit;font-weight:600}
  input,select,textarea{font:inherit;font-weight:500}
  input,select,textarea{padding:12px 15px;border:1.5px solid var(--line);border-radius:11px;outline:none;width:100%;background:#fff;font-size:1rem;transition:.2s;color:var(--ink)}
  input:focus,select:focus,textarea:focus{border-color:var(--orange);box-shadow:0 0 0 4px rgba(224,118,44,.14)}
  input::placeholder,textarea::placeholder{color:#aa9889}
  label{display:block;font-size:.9rem;font-weight:700;color:var(--brown);margin-bottom:7px;margin-top:14px}

  /* Layout */
  .app{display:grid;grid-template-columns:240px 1fr;min-height:100vh}
  aside{background:linear-gradient(180deg,var(--brown-deep) 0%,var(--brown) 100%);color:#fff;padding:20px 14px;position:sticky;top:0;height:100vh;overflow-y:auto}
  aside::-webkit-scrollbar{width:6px}aside::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:3px}
  .brand{display:flex;align-items:center;gap:13px;padding:0 8px 18px;border-bottom:1px solid rgba(255,255,255,.1)}
  .brand .mono{width:46px;height:46px;border-radius:13px;background:var(--grad);display:grid;place-items:center;font-family:'Playfair Display';font-weight:900;font-size:1.2rem;color:#fff;box-shadow:0 8px 18px -8px rgba(168,35,28,.6)}
  .brand b{font-family:'Playfair Display';font-size:1.22rem;display:block;font-weight:800;letter-spacing:-.01em}
  .brand small{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.7rem;letter-spacing:.16em;color:rgba(255,255,255,.65);text-transform:uppercase;margin-top:3px}

  .nav{margin-top:14px;display:flex;flex-direction:column;gap:2px}
  .nav .group{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.5);padding:18px 12px 8px;font-weight:800}
  .nav a{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;color:rgba(255,255,255,.88);font-weight:600;font-size:1rem;transition:.18s;cursor:pointer;letter-spacing:.005em}
  .nav a:hover{background:rgba(255,255,255,.08);color:#fff}
  .nav a.active{background:var(--grad);color:#fff;box-shadow:0 8px 20px -8px rgba(168,35,28,.55);font-weight:700}
  .nav a .ic{width:22px;flex:none;text-align:center;font-size:1.1rem}
  .nav a .badge{margin-left:auto;background:var(--red);font-size:.72rem;padding:2px 8px;border-radius:99px;font-weight:800;min-width:22px;text-align:center}
  .nav a.active .badge{background:rgba(255,255,255,.28)}

  .user-mini{margin-top:22px;padding:14px;background:rgba(255,255,255,.08);border-radius:14px;display:flex;align-items:center;gap:11px;border:1px solid rgba(255,255,255,.06)}
  .user-mini .av{width:46px;height:46px;border-radius:50%;background:var(--grad);display:grid;place-items:center;font-weight:800;flex:none;overflow:hidden;border:2px solid var(--gold)}
  .user-mini .av img{width:100%;height:100%;object-fit:cover;object-position:center 22%}
  .user-mini b{font-size:.96rem;display:block;font-weight:700;color:#fff}
  .user-mini span{font-size:.78rem;color:rgba(255,255,255,.65);font-weight:500}

  /* Main */
  main{padding:0;overflow-x:hidden}
  header.topbar{position:sticky;top:0;z-index:30;background:rgba(250,247,242,.95);backdrop-filter:blur(14px);padding:16px 28px;display:flex;align-items:center;gap:16px;border-bottom:1px solid var(--line)}
  header.topbar h1{font-size:1.6rem;font-weight:800;color:var(--brown-deep);letter-spacing:-.01em;line-height:1.2}
  header.topbar h1 .sub{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.92rem;color:var(--muted);font-weight:600;margin-top:3px;letter-spacing:0}
  .topbar .search{margin-left:auto;display:flex;align-items:center;gap:9px;background:#fff;padding:11px 18px;border-radius:99px;border:1.5px solid var(--line);width:320px;box-shadow:var(--shadow-sm);transition:.2s}
  .topbar .search:focus-within{border-color:var(--orange);box-shadow:0 0 0 4px rgba(224,118,44,.12)}
  .topbar .search input{flex:1;border:0;outline:0;font-size:.96rem;background:transparent;padding:0;font-weight:500}
  .topbar .search input:focus{box-shadow:none}
  .topbar .icon-btn{width:44px;height:44px;border-radius:50%;background:#fff;display:grid;place-items:center;border:1.5px solid var(--line);position:relative;box-shadow:var(--shadow-sm);cursor:pointer;font-size:1.15rem;transition:.2s}
  .topbar .icon-btn:hover{background:var(--cream);border-color:var(--gold)}
  .topbar .icon-btn .dot{position:absolute;top:8px;right:8px;width:9px;height:9px;border-radius:50%;background:var(--red);border:2px solid #fff;box-shadow:0 0 0 0 rgba(168,35,28,.5);animation:pulseDot 2s infinite}
  @keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 rgba(168,35,28,.5)}50%{box-shadow:0 0 0 6px rgba(168,35,28,0)}}
  .topbar .profile{display:flex;align-items:center;gap:11px;padding:5px 16px 5px 5px;background:#fff;border-radius:99px;border:1.5px solid var(--line);box-shadow:var(--shadow-sm);cursor:pointer;transition:.2s}
  .topbar .profile:hover{border-color:var(--gold);background:var(--cream)}
  .topbar .profile .av{width:40px;height:40px;border-radius:50%;background:var(--grad);display:grid;place-items:center;color:#fff;font-weight:800;overflow:hidden;border:2px solid var(--gold);flex:none}
  .topbar .profile .av img{width:100%;height:100%;object-fit:cover;object-position:center 22%}
  .topbar .profile b{font-size:.94rem;display:block;font-weight:700;color:var(--brown-deep);line-height:1.2}
  .topbar .profile span:not(.av){font-size:.78rem;color:var(--muted);font-weight:600}

  section.page{padding:22px 26px 40px;display:none;animation:fadeIn .35s ease}
  section.page.active{display:block}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  /* Cards & grid */
  .grid{display:grid;gap:16px}
  .kpi-grid{grid-template-columns:repeat(4,1fr)}
  .kpi{background:#fff;border-radius:16px;padding:18px;border:1px solid var(--line);position:relative;overflow:hidden;transition:.25s;cursor:pointer}
  .kpi:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
  .kpi .ic{width:50px;height:50px;border-radius:14px;display:grid;place-items:center;font-size:1.5rem;color:#fff;margin-bottom:14px;box-shadow:0 8px 18px -8px rgba(0,0,0,.2)}
  .kpi.k1 .ic{background:linear-gradient(135deg,var(--gold),var(--gold-deep))}
  .kpi.k2 .ic{background:linear-gradient(135deg,#F39C12,var(--orange))}
  .kpi.k3 .ic{background:linear-gradient(135deg,var(--orange),var(--red))}
  .kpi.k4 .ic{background:linear-gradient(135deg,var(--red),var(--red-deep))}
  .kpi .label{font-size:.88rem;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.05em}
  .kpi .val{font-family:'Playfair Display';font-size:2.3rem;font-weight:800;color:var(--brown-deep);line-height:1.05;margin:5px 0 4px;letter-spacing:-.02em}
  .kpi .delta{font-size:.92rem;color:var(--green);font-weight:700}
  .kpi .delta.down{color:var(--red)}

  .card{background:#fff;border-radius:16px;padding:22px;border:1px solid var(--line);box-shadow:var(--shadow-sm)}
  .card h2,.card h3{font-family:'Plus Jakarta Sans','Be Vietnam Pro',sans-serif;font-weight:800;font-size:1.15rem;color:var(--brown-deep);margin-bottom:4px;letter-spacing:-.01em}
  .card .sub{font-size:.92rem;color:var(--muted);margin-bottom:16px;font-weight:500}
  .card-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;gap:12px;flex-wrap:wrap}
  .card-head h2,.card-head h3{margin:0}

  .pill{font-size:.82rem;font-weight:700;padding:5px 12px;border-radius:99px;background:var(--cream);color:var(--orange-deep);display:inline-block;letter-spacing:.01em}
  .pill.green{background:#E6F7EE;color:var(--green)}
  .pill.red{background:#FDEAEA;color:var(--red)}
  .pill.blue{background:#E6F0FB;color:var(--blue)}
  .pill.purple{background:#F4ECF7;color:var(--purple)}
  .pill.gray{background:#EEE;color:#555}

  .btn{display:inline-flex;align-items:center;gap:8px;padding:11px 19px;border-radius:11px;font-weight:700;font-size:.96rem;background:var(--grad);color:#fff;transition:.22s;box-shadow:0 8px 20px -10px rgba(201,85,26,.5);letter-spacing:.005em;min-height:42px;line-height:1.2}
  .btn:hover{transform:translateY(-2px);box-shadow:0 12px 26px -10px rgba(201,85,26,.6)}
  .btn:active{transform:translateY(0)}
  .btn.ghost{background:#fff;color:var(--brown-deep);border:1.5px solid var(--line);box-shadow:none}
  .btn.ghost:hover{background:var(--cream);border-color:var(--gold)}
  .btn.sm{padding:7px 13px;font-size:.86rem;min-height:34px}
  .btn.danger{background:linear-gradient(135deg,var(--red),var(--red-deep))}
  .btn.green{background:linear-gradient(135deg,#16A085,#27AE60)}

  .row{display:grid;gap:16px;margin-top:16px}
  .r-2-1{grid-template-columns:2fr 1fr}
  .r-1-2{grid-template-columns:1fr 2fr}
  .r-3{grid-template-columns:repeat(3,1fr)}
  .r-2{grid-template-columns:1fr 1fr}

  table{width:100%;border-collapse:collapse;font-size:.98rem}
  th{text-align:left;font-weight:700;color:var(--brown);text-transform:uppercase;font-size:.78rem;letter-spacing:.06em;padding:11px 12px;border-bottom:2px solid var(--line);background:#FBF7EE}
  td{padding:14px 12px;border-bottom:1px solid var(--line);color:var(--ink);font-weight:500}
  tr:last-child td{border:0}
  tr.clickable{cursor:pointer;transition:.15s}
  tr.clickable:hover td{background:#FFFCF6}
  .avatar{width:38px;height:38px;border-radius:50%;background:var(--grad);display:inline-grid;place-items:center;color:#fff;font-weight:800;font-size:.95rem;flex:none;overflow:hidden}
  .avatar img{width:100%;height:100%;object-fit:cover;object-position:center 25%}
  .with-av{display:flex;align-items:center;gap:11px}
  .with-av b{font-weight:700;color:var(--brown-deep);display:block;line-height:1.35;font-size:.98rem}
  .with-av span{font-size:.84rem;color:var(--muted);font-weight:500}

  /* Tiers */
  .tier{display:inline-block;font-size:.78rem;font-weight:800;padding:4px 11px;border-radius:99px;letter-spacing:.05em;text-transform:uppercase}
  .tier.diamond{background:linear-gradient(135deg,#A8C5E8,#5DA0DC);color:#fff}
  .tier.gold{background:var(--grad);color:#fff}
  .tier.silver{background:linear-gradient(135deg,#D0D0D0,#9A9A9A);color:#fff}

  /* Calendar */
  .cal-grid{display:grid;grid-template-columns:70px repeat(7,1fr);gap:1px;background:var(--line);border-radius:12px;overflow:hidden;border:1px solid var(--line)}
  .cal-grid > div{background:#fff;padding:9px 10px;min-height:62px;font-size:.76rem}
  .cal-head{background:var(--cream)!important;font-weight:700;color:var(--brown-deep);text-align:center}
  .cal-head .d{font-family:'Playfair Display';font-size:1.3rem;line-height:1}
  .cal-head.today{background:var(--grad)!important;color:#fff!important}
  .cal-time{color:var(--muted);font-weight:600;text-align:right;border-right:1px solid var(--line)}
  .cal-slot{position:relative;cursor:pointer;transition:.15s}
  .cal-slot:hover{background:#FFFCF6!important}
  .booking{position:absolute;left:3px;right:3px;top:3px;background:var(--grad);color:#fff;padding:6px 7px;border-radius:7px;font-size:.72rem;font-weight:600;cursor:pointer}
  .booking.b2{background:linear-gradient(135deg,var(--gold),var(--gold-deep))}
  .booking.b3{background:linear-gradient(135deg,var(--orange),var(--red))}
  .booking .who{font-size:.76rem;font-weight:700;margin-bottom:1px}
  .booking .what{opacity:.9;font-size:.68rem}

  /* Service cards */
  .svc-grid{grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
  .svc{background:#fff;border-radius:14px;border:1px solid var(--line);overflow:hidden;transition:.25s;cursor:pointer}
  .svc:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
  .svc .pic{height:120px;background:var(--grad);display:grid;place-items:center;font-size:2.6rem;color:rgba(255,255,255,.6)}
  .svc .body{padding:16px}
  .svc h3{font-size:.96rem;font-weight:700;margin-bottom:5px}
  .svc .price{font-family:'Playfair Display';font-size:1.3rem;font-weight:800;color:var(--orange-deep)}
  .svc .meta{font-size:.76rem;color:var(--muted);margin-top:3px}

  /* AI */
  .ai-card{background:linear-gradient(135deg,var(--brown-deep),var(--red-deep));color:#fff;border-radius:16px;padding:20px;position:relative;overflow:hidden}
  .ai-card::before{content:"";position:absolute;right:-50px;top:-50px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(232,194,90,.3),transparent 70%)}
  .ai-card h3{color:var(--gold)!important;font-family:'Playfair Display';font-size:1.15rem;margin-bottom:5px;position:relative;z-index:1}
  .ai-icon{display:inline-block;width:34px;height:34px;border-radius:10px;background:var(--grad);display:grid;place-items:center;margin-bottom:10px}
  .ai-insight{background:rgba(255,255,255,.08);border-radius:11px;padding:12px;margin-top:10px;font-size:.86rem;border-left:3px solid var(--gold);position:relative;z-index:1}
  .ai-insight b{color:var(--gold)}

  .alert{display:flex;gap:12px;padding:15px 17px;border-radius:13px;margin-bottom:11px;font-size:.96rem;align-items:flex-start;line-height:1.55;font-weight:500}
  .alert.warn{background:#FFF6E6;border:1px solid #F5C97C;color:#8B5A00}
  .alert.danger{background:#FDEAEA;border:1px solid #F0AAA8;color:var(--red-deep)}
  .alert.info{background:#E6F0FB;border:1px solid #B0CCEB;color:#1A5494}
  .alert.success{background:#E6F7EE;border:1px solid #9BD8B5;color:#1E6B3A}
  .alert .ic{font-size:1.1rem;flex:none}
  .alert button{margin-left:auto}

  .progress{height:8px;background:var(--line);border-radius:99px;overflow:hidden}
  .progress > div{height:100%;background:var(--grad);transition:width .8s}
  .stock-low{color:var(--red);font-weight:700}
  .stock-ok{color:var(--green);font-weight:700}

  .camp{background:#fff;border-radius:12px;padding:15px;border:1px solid var(--line);display:flex;gap:12px;align-items:center;cursor:pointer}
  .camp .ic{width:44px;height:44px;border-radius:11px;background:var(--grad);display:grid;place-items:center;font-size:1.2rem;color:#fff;flex:none}

  .review{padding:14px;border-bottom:1px solid var(--line);display:flex;gap:12px}
  .review:last-child{border:0}
  .stars{color:var(--gold-deep);font-size:.9rem;letter-spacing:2px}

  /* AI chat */
  .ai-chat{background:#fff;border-radius:14px;padding:16px;border:1px solid var(--line);display:flex;flex-direction:column;height:560px}
  .ai-msg{margin-bottom:10px;padding:11px 13px;border-radius:13px;max-width:84%;font-size:.9rem;animation:fadeIn .3s}
  .ai-msg.bot{background:var(--cream);color:var(--brown-deep);border-bottom-left-radius:4px}
  .ai-msg.user{background:var(--grad);color:#fff;margin-left:auto;border-bottom-right-radius:4px}

  /* === MODAL === */
  .modal-bg{position:fixed;inset:0;background:rgba(59,33,19,.55);backdrop-filter:blur(4px);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px;animation:fadeIn .25s}
  .modal-bg.show{display:flex}
  .modal{background:#fff;border-radius:18px;max-width:680px;width:100%;max-height:90vh;overflow-y:auto;animation:modalIn .3s cubic-bezier(.16,1,.3,1)}
  .modal.lg{max-width:900px}
  .modal.sm{max-width:480px}
  @keyframes modalIn{from{opacity:0;transform:translateY(20px) scale(.98)}to{opacity:1;transform:none}}
  .modal-head{position:sticky;top:0;background:#fff;display:flex;justify-content:space-between;align-items:center;padding:22px 26px;border-bottom:1px solid var(--line);z-index:2}
  .modal-head h2{font-family:'Be Vietnam Pro';font-size:1.18rem;font-weight:800;color:var(--brown-deep)}
  .modal-head .close{width:36px;height:36px;border-radius:50%;background:var(--cream);display:grid;place-items:center;font-size:1.1rem;color:var(--brown);cursor:pointer}
  .modal-body{padding:22px 26px 26px}
  .modal-foot{position:sticky;bottom:0;background:#fff;padding:14px 26px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px}

  /* Toast */
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:linear-gradient(135deg,#3B2113,#5A3620);color:#fff;padding:13px 22px;border-radius:12px;font-weight:600;font-size:.9rem;box-shadow:0 18px 50px -14px rgba(0,0,0,.5);z-index:1100;opacity:0;transition:.35s;pointer-events:none;max-width:80vw}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  .toast.green{background:linear-gradient(135deg,#16A085,#27AE60)}
  .toast.red{background:linear-gradient(135deg,var(--red),var(--red-deep))}
  .toast .ic{margin-right:7px}

  /* Status pills */
  .status{display:inline-flex;align-items:center;gap:7px;padding:5px 12px;border-radius:99px;font-size:.84rem;font-weight:700;letter-spacing:.005em}
  .status::before{content:"";width:6px;height:6px;border-radius:50%}
  .status.green::before{background:var(--green)}
  .status.green{background:#E6F7EE;color:var(--green)}
  .status.blue::before{background:var(--blue)}
  .status.blue{background:#E6F0FB;color:var(--blue)}
  .status.red::before{background:var(--red)}
  .status.red{background:#FDEAEA;color:var(--red)}
  .status.gold::before{background:var(--gold-deep)}
  .status.gold{background:#FFF6E0;color:var(--gold-deep)}
  .status.gray::before{background:#888}
  .status.gray{background:#F0F0F0;color:#555}

  /* Tasks */
  .task{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px;display:flex;gap:12px;align-items:flex-start;margin-bottom:8px;transition:.2s}
  .task:hover{border-color:var(--gold)}
  .task.done{opacity:.55;background:var(--cream)}
  .task input[type=checkbox]{flex:none;width:18px;height:18px;margin-top:2px;accent-color:var(--orange)}
  .task .meta{display:flex;gap:10px;font-size:.74rem;color:var(--muted);margin-top:5px;flex-wrap:wrap}
  .task .meta b{color:var(--brown)}

  /* Care timeline */
  .timeline{position:relative;padding-left:28px}
  .timeline::before{content:"";position:absolute;left:8px;top:0;bottom:0;width:2px;background:var(--line)}
  .tl-item{position:relative;padding-bottom:16px}
  .tl-item::before{content:"";position:absolute;left:-26px;top:4px;width:18px;height:18px;border-radius:50%;background:#fff;border:3px solid var(--gold-deep)}
  .tl-item.done::before{background:var(--green);border-color:var(--green)}
  .tl-item.due::before{background:var(--red);border-color:var(--red);animation:pulse 1.5s infinite}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(168,35,28,.6)}50%{box-shadow:0 0 0 8px rgba(168,35,28,0)}}
  .tl-item b{display:block;color:var(--brown-deep)}
  .tl-item span{font-size:.78rem;color:var(--muted)}

  /* Photo gallery */
  .gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
  .photo-pair{background:#fff;border-radius:12px;overflow:hidden;border:1px solid var(--line);cursor:pointer;transition:.25s}
  .photo-pair:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
  .photo-pair .imgs{display:grid;grid-template-columns:1fr 1fr;height:140px;position:relative}
  .photo-pair .imgs > div{display:grid;place-items:center;font-size:2.5rem}
  .photo-pair .imgs > div:first-child{background:linear-gradient(135deg,#F0E5D0,#E8DCC0)}
  .photo-pair .imgs > div:last-child{background:linear-gradient(135deg,#FFF8EC,#FBEFD8)}
  .photo-pair .imgs::after{content:"VS";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--brown-deep);color:#fff;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:.7rem;font-weight:800}
  .photo-pair .info{padding:12px}

  /* Table wrapper - scroll ngang mượt trên mobile */
  .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:12px;margin:0 -4px;padding:0 4px;scroll-snap-type:x proximity}
  .tbl-wrap table{min-width:540px}
  .tbl-wrap::-webkit-scrollbar{height:6px}
  .tbl-wrap::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}
  .tbl-wrap::-webkit-scrollbar-thumb:hover{background:var(--gold)}

  /* Sidebar overlay (khi mở trên mobile) */
  .sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(59,33,19,.55);backdrop-filter:blur(3px);z-index:45;animation:fadeIn .25s}
  .sidebar-backdrop.show{display:block}
  .menu-toggle{display:none;width:42px;height:42px;border-radius:50%;background:#fff;border:1px solid var(--line);place-items:center;cursor:pointer;font-size:1.15rem;color:var(--brown-deep);flex:none}
  .menu-toggle:hover{background:var(--cream)}
  .sidebar-close{display:none;position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.1);place-items:center;color:#fff;font-size:1.1rem;cursor:pointer;z-index:2}

  /* ===============================
     RESPONSIVE — 4 TẦNG THIẾT BỊ
     iPhone · Android · iPad · Desktop
     =============================== */

  /* ===== Desktop nhỏ + iPad ngang (1024–1280px) ===== */
  @media (max-width:1280px){
    .app{grid-template-columns:220px 1fr}
    aside{padding:18px 11px}
    .nav a{font-size:.84rem;padding:8px 10px}
    section.page{padding:20px 22px 36px}
    header.topbar{padding:13px 22px}
    .topbar .search{width:230px}
  }

  /* ===== iPad dọc / Tablet (768–1100px) ===== */
  @media (max-width:1100px){
    .app{grid-template-columns:1fr}
