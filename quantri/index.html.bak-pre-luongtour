function importExcelFile(file, target){
  if(!window.XLSX){ toast('⏳ Đang tải SheetJS...','red'); return; }
  const r = new FileReader();
  r.onload = (e) => {
    try {
      const wb = XLSX.read(e.target.result, {type:'array'});
      const sheet = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(sheet);
      window._importPreview = {target, rows};
      showImportPreview(target, rows);
    } catch(err){ toast('❌ Lỗi đọc file: '+err.message,'red'); }
  };
  r.readAsArrayBuffer(file);
}
function showImportPreview(target, rows){
  const t = document.getElementById('modalTitle');
  const b = document.getElementById('modalBody');
  modalEl.classList.add('lg');
  t.textContent = `⬆ Nhập Excel — ${rows.length} dòng được phát hiện`;
  const cols = Object.keys(rows[0]||{});
  b.innerHTML = `
    <div class="alert info"><span class="ic">📋</span><div><b>Xem trước:</b> ${rows.length} dòng dữ liệu. Bấm "Xác nhận" sẽ <b>thêm mới</b> vào hệ thống (không ghi đè bản hiện tại).</div></div>
    <div style="max-height:340px;overflow:auto;border:1px solid var(--line);border-radius:10px;margin:14px 0">
      <table style="font-size:.82rem"><thead><tr>${cols.map(c=>`<th>${c}</th>`).join('')}</tr></thead>
      <tbody>${rows.slice(0,20).map(r=>`<tr>${cols.map(c=>`<td>${r[c]||''}</td>`).join('')}</tr>`).join('')}</tbody></table>
    </div>
    ${rows.length>20?`<div class="sub">Hiển thị 20/${rows.length} dòng đầu</div>`:''}
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
      <button class="btn ghost sm" onclick="closeModal()">Huỷ</button>
      <button class="btn sm" onclick="confirmImport()">✓ Xác nhận nhập ${rows.length} dòng</button>
    </div>
  `;
  modalBg.classList.add('show');
}
function confirmImport(){
  const {target, rows} = window._importPreview || {};
  if(!rows) return;
  // Map back from Excel headers to internal keys
  const mappers = {
    customers: r => ({id: Date.now()+Math.random(), name:r['Họ tên']||r.name, phone:r['SĐT']||r.phone, age:+r['Tuổi']||30, tier:(r['Hạng']||r.tier||'silver').toLowerCase(), ltv:+r['LTV (VNĐ)']||0, visits:+r['Số ca']||0, points:+r['Điểm']||0, aiScore:+r['AI Score']||60, aiTag:r['Tag AI']||'Mới', lastVisit:r['Gần nhất']||'Vừa thêm', avBg:'var(--grad)'}),
    staff: r => ({id:r['Mã NV']||'NV-'+Date.now(), name:r['Họ tên']||r.name, role:r['Vai trò']||'KTV', spec:r['Chuyên môn']||'', phone:r['SĐT']||'', email:r['Email']||'', tags:(r['Tags']||'').split(',').map(t=>t.trim()).filter(Boolean), skills:(r['Kỹ năng']||'').split(',').map(t=>t.trim()).filter(Boolean), sessions:+r['Ca tháng']||0, rating:r['Đánh giá']||'5.0 ⭐', revenue:r['Doanh thu']||'0', kpi:r['KPI']||'100%', kpiClass:'', status:r['Trạng thái']||'active', av:(r['Họ tên']||'X').slice(0,1).toUpperCase(), bg:'linear-gradient(135deg,#16A085,#27AE60)'}),
    tasks: r => ({id:Date.now()+Math.random(), title:r['Tiêu đề']||r.title, priority:r['Mức độ']||'TB', owner:r['Người phụ trách']||'CEO Phương', due:r['Hạn']||'Hôm nay', tag:r['Phân loại']||'Khác', done:r['Trạng thái']==='Hoàn thành'}),
    inventory: r => ({sku:r['SKU'], name:r['Tên']||r.name, stock:+r['Tồn']||0, unit:r['Đơn vị']||'cái', min:+r['Min']||10, runOut:r['Dự đoán hết']||'?', low:+r['Tồn']<+r['Min']}),
    medical: r => ({code:r['Mã HS']||'HS-'+Date.now(), name:r['Khách']||r.name, age:+r['Tuổi']||30, history:r['Tiền sử / Dị ứng']||'', lastVisit:r['Lần gần nhất']||'Mới tạo', protocol:r['Phác đồ']||''})
  };
  const mapper = mappers[target];
  if(!mapper){ toast('❌ Không hỗ trợ import cho '+target,'red'); return; }
  const newRows = rows.map(mapper);
  DATA[target] = [...DATA[target], ...newRows];
  saveData(target, DATA[target]);
  closeModal();
  toast(`✓ Đã nhập ${newRows.length} dòng vào ${target}`,'green');
  // re-render
  if(target==='customers') renderCRM();
  if(target==='staff') renderStaff();
  if(target==='tasks') renderTasks();
  if(target==='inventory') renderInventory();
  if(target==='medical') renderMedical();
}
