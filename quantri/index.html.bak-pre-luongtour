    aside.open{left:0;box-shadow:0 0 60px rgba(0,0,0,.4)}
    .sidebar-close{display:grid}
    .menu-toggle{display:grid!important}
    header.topbar{padding:12px 20px;padding-top:calc(env(safe-area-inset-top, 0px) + 12px);gap:10px}
    .topbar .search{flex:1;width:auto;min-width:0}
    .kpi-grid{grid-template-columns:repeat(2,1fr)}
    .r-2-1,.r-1-2,.r-3,.r-2{grid-template-columns:1fr}
    .ai-chat{height:480px}
    .cal-grid{grid-template-columns:60px repeat(7,minmax(100px,1fr));min-width:760px}
    .row.r-2-1, .row.r-1-2{grid-template-columns:1fr}
    section.page{padding:18px 18px 32px}
  }

  /* ===== Mobile lớn (iPhone Plus / Android lớn 481–767px) ===== */
  @media (max-width:767px){
    body{font-size:13.5px}
    header.topbar{padding:10px 14px;padding-top:calc(env(safe-area-inset-top, 0px) + 10px);gap:8px;flex-wrap:wrap}
    header.topbar h1{font-size:1.12rem;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    header.topbar h1 .sub{font-size:.66rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
    .topbar .search{order:10;flex-basis:100%;width:100%;padding:7px 12px;margin-top:4px}
    .topbar .search input{font-size:.84rem}
    .topbar .icon-btn{width:38px;height:38px}
    .topbar .profile{padding:4px 9px 4px 4px}
    .topbar .profile span:not(.av){display:none}
    .topbar .profile .av{width:30px;height:30px;font-size:.78rem}
    section.page{padding:14px 14px 90px}
    .kpi-grid{grid-template-columns:repeat(2,1fr);gap:10px}
    .kpi{padding:14px}
    .kpi .ic{width:38px;height:38px;font-size:1.1rem;margin-bottom:8px}
    .kpi .val{font-size:1.55rem}
    .kpi .label{font-size:.66rem}
    .kpi .delta{font-size:.7rem}
    .card{padding:16px;border-radius:14px}
    .card-head{flex-direction:column;align-items:flex-start;gap:8px}
    .card-head .btn,.card-head .pill{align-self:flex-start}
    h2{font-size:1.05rem}
    h3{font-size:.95rem}
    .grid,.row{gap:12px}
    .row{margin-top:12px}
