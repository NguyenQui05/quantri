/* ===== AI CHAT ===== */
const aiHistory = [];
async function sendAI(){
  const input = document.getElementById('aiInput');
  const msgs = document.getElementById('aiMessages');
  const sendBtn = document.getElementById('aiSend');
  const status = document.getElementById('aiStatus');
  const text = (input.value || '').trim();
  if (!text) return;
  input.value = '';
  const um = document.createElement('div'); um.className='ai-msg user'; um.textContent=text; msgs.appendChild(um);
  const tm = document.createElement('div'); tm.className='ai-msg bot'; tm.textContent='…'; msgs.appendChild(tm);
  msgs.scrollTop = msgs.scrollHeight;
  sendBtn.disabled = true;
  status.textContent = '● Đang suy nghĩ...'; status.style.color = 'var(--orange-deep)';
  try {
    const res = await fetch('/api/ai', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ message:text, history: aiHistory.slice(-10) }) });
    const data = await res.json();
    const reply = data.reply || data.error || 'Em chưa kết nối được, chị thử lại nhé.';
    tm.innerHTML = String(reply).replace(/\n/g,'<br>');
    aiHistory.push({role:'user',text}); aiHistory.push({role:'model',text:reply});
  } catch (e) {
    tm.textContent = 'Lỗi: ' + (e?.message || e); tm.style.color='var(--red)';
  } finally {
    sendBtn.disabled = false;
    status.textContent = '● Gemini 2.5 Flash · Sẵn sàng'; status.style.color='var(--green)';
    msgs.scrollTop = msgs.scrollHeight;
  }
}
window.sendAI = sendAI;

