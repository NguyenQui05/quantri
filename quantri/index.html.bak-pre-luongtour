/* ===== LOCAL STORAGE ===== */
function loadData(key, fallback){ try{const v=localStorage.getItem('hana_'+key); return v?JSON.parse(v):fallback}catch{return fallback} }
function saveData(key, val){ try{localStorage.setItem('hana_'+key, JSON.stringify(val))}catch{} }

// Hydrate from localStorage if exists
Object.keys(DATA).forEach(k=>{ DATA[k] = loadData(k, DATA[k]) });

/* ===== TOAST ===== */
let toastEl;
function toast(msg, type='dark'){
  if(toastEl)toastEl.remove();
  toastEl=document.createElement('div');
  toastEl.className='toast '+(type==='ok'?'green':type==='err'?'red':type==='green'?'green':type==='red'?'red':'');
  toastEl.innerHTML=`<span class="ic">${type==='ok'||type==='green'?'✓':type==='err'||type==='red'?'⚠️':'💡'}</span>${msg}`;
  document.body.appendChild(toastEl);
  requestAnimationFrame(()=>toastEl.classList.add('show'));
  setTimeout(()=>{toastEl?.classList.remove('show');setTimeout(()=>toastEl?.remove(),400)},2800);
}

