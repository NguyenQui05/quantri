// Swipe-to-close sidebar trên mobile
(function initSwipeSidebar(){
  let startX=0, startY=0, tracking=false;
  const side=document.getElementById('sidebar');
  if(!side) return;
  side.addEventListener('touchstart',e=>{startX=e.touches[0].clientX;startY=e.touches[0].clientY;tracking=true},{passive:true});
  side.addEventListener('touchmove',e=>{
    if(!tracking) return;
    const dx=e.touches[0].clientX-startX, dy=e.touches[0].clientY-startY;
    if(Math.abs(dx)>Math.abs(dy) && dx<-50){ closeSidebar(); tracking=false; }
  },{passive:true});
  side.addEventListener('touchend',()=>tracking=false,{passive:true});
})();

